# ============================================================
# CLÉS API — services externes
# ============================================================

# Clé API Mistral (embeddings + génération)
# À obtenir sur https://console.mistral.ai/ (compte gratuit disponible)
MISTRAL_API_KEY=<votre_cle_api>

# Clé API Google AI (LLM juge pour l'évaluation, Gemini)
# À obtenir sur https://aistudio.google.com/
GOOGLE_API_KEY=<votre_cle_api>


# ============================================================
# AUTHENTIFICATION — application
# ============================================================

# Clé secrète utilisée pour signer les tokens JWT (connexion utilisateur)
# Générez une valeur aléatoire forte, par exemple avec :
#   openssl rand -hex 32
# Ne réutilisez jamais une clé d'exemple ou d'un autre projet.
JWT_SECRET_KEY=<votre_cle_JWT>

# ============================================================
# BASE DE DONNÉES — superuser Postgres (Docker)
# ============================================================
# Ces identifiants servent UNIQUEMENT à l'initialisation du conteneur
# Postgres (docker-compose) et aux tâches d'administration ponctuelles
# (création du rôle applicatif, extensions). L'application elle-même
# ne les utilise jamais au quotidien — voir APP_DB_USER plus bas.

POSTGRES_USER=<choisissez_un_identifiant>
POSTGRES_PASSWORD=<choisissez_un_mot_de_passe>

# ============================================================
# BASE DE DONNÉES — rôle applicatif (utilisé par FastAPI)
# ============================================================
# Un rôle Postgres séparé, avec des privilèges restreints, dédié à
# l'application. Doit être créé manuellement une fois avant le premier
# lancement — voir la section "Installation" du README pour la
# commande exacte (CREATE ROLE ... NOBYPASSRLS).
# Choisissez un mot de passe DIFFÉRENT de POSTGRES_PASSWORD ci-dessus.

APP_DB_USER=rag_app_user
APP_DB_PASSWORD=<choisissez_un_mot_de_passe_different>

# Chaîne de connexion utilisée par l'application (psycopg2/PGVector).
# Construite automatiquement dans src/config.py à partir de APP_DB_USER
# et APP_DB_PASSWORD ci-dessus — vous n'avez normalement pas besoin de
# la modifier, sauf si vous changez le host/port de la base.
PSYCOPG2_CONNECTION_STRING=<postgresql://<APP_DB_USER>:<APP_DB_PASSWORD>@localhost:5432/vector_db>

# ============================================================
# PGADMIN — interface d'administration de la base (optionnel)
# ============================================================
# Identifiants de connexion à l'interface web pgAdmin (localhost:8080)
# Peuvent être n'importe quel email/mot de passe de votre choix,
# utilisés uniquement pour se connecter à pgAdmin, pas à Postgres lui-même.

PGADMIN_DEFAULT_EMAIL=<votre_mail>
PGADMIN_DEFAULT_PASSWORD=<votre_mot_de_passe>